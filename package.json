{
	"name": "ogulniega-mobile",
	"version": "1.1.0",
	"private": true,
	"description": "Nieoficjalna aplikacja mobilna (PWA + APK) dla klienta Ogulniega Minecraft, z backendem Rust/Tauri",
	"license": "MIT",
	"scripts": {
		"serve": "npx --yes http-server www -p 8080 -c-1",
		"sync": "cap sync android",
		"open": "cap open android",
		"icons": "python3 tools/make-icons.py",
		"tauri": "tauri",
		"rust:dev": "tauri dev",
		"rust:build": "tauri build",
		"rust:android": "tauri android build --apk",
		"rust:android-init": "tauri android init"
	},
	"dependencies": {
		"@capacitor/android": "^7.0.0",
		"@capacitor/core": "^7.0.0",
		"@tauri-apps/api": "^2.0.0"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.0",
		"@tauri-apps/cli": "^2.0.0"
	}
}
